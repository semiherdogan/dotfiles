#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AI_DIR="$ROOT_DIR/ai"
SKILLS_DIR="$AI_DIR/skills"
LOCAL_SKILLS_DIR="$AI_DIR/skills-local"
PI_EXTENSIONS_DIR="$AI_DIR/extensions/pi"
PI_AGENTS_DIR="$AI_DIR/agents/pi"
PI_AGENTS_LOCAL="$AI_DIR/config/pi-agents.local.json"
PI_SETTINGS="$AI_DIR/config/pi-settings.json"
PI_ADHD_CONFIG="$AI_DIR/config/pi-i-have-adhd.json"
FORCE=0
ONLY="pi"

usage() {
    cat <<EOF
Usage: setup-ai [--force] [--only pi,codex,claude]

Installs AI instructions and skills for agent directories that already exist.
Only Pi is installed by default; request Codex or Claude with --only.

Options:
  --force, -f  Create missing agent directories before installing.
  --only LIST  Install only selected agents: pi, codex, claude.
  --help, -h   Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --force | -f)
            FORCE=1
            ;;
        --only)
            if [ "$#" -lt 2 ]; then
                echo "--only requires a comma-separated list." >&2
                usage >&2
                exit 1
            fi
            ONLY="$2"
            shift
            ;;
        --only=*)
            ONLY="${1#--only=}"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

validate_only_list() {
    local item
    local old_ifs

    if [ -z "$ONLY" ]; then
        echo "--only requires a comma-separated list." >&2
        usage >&2
        exit 1
    fi

    old_ifs="$IFS"
    IFS=","
    for item in $ONLY; do
        IFS="$old_ifs"
        case "$item" in
            pi | codex | claude)
                ;;
            "")
                echo "Empty agent name in --only list." >&2
                exit 1
                ;;
            *)
                echo "Unknown agent in --only list: $item" >&2
                usage >&2
                exit 1
                ;;
        esac
        IFS=","
    done
    IFS="$old_ifs"

    return 0
}

is_selected() {
    local agent="$1"
    local item
    local old_ifs

    old_ifs="$IFS"
    IFS=","
    for item in $ONLY; do
        IFS="$old_ifs"
        if [ "$item" = "$agent" ]; then
            return 0
        fi
        IFS=","
    done
    IFS="$old_ifs"

    return 1
}

install_ai_instructions() {
    local tool_file="$1"
    local target="$2"
    local target_dir
    local tmp_file

    target_dir="$(dirname "$target")"
    mkdir -p "$target_dir"

    tmp_file="$(mktemp "${target}.tmp.XXXXXX")"
    {
        cat "$AI_DIR/instructions.md"
        printf '\n\n'
        cat "$AI_DIR/$tool_file"
    } > "$tmp_file"

    mv "$tmp_file" "$target"
}

install_ai_skills() {
    local target="$1"
    local marker
    local skill
    local skill_name
    local skills_dir
    local tmp_marker

    marker="$target/.dotfiles-managed"

    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r skill_name; do
            [ -n "$skill_name" ] || continue
            rm -rf "$target/$skill_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    for skills_dir in "$SKILLS_DIR" "$LOCAL_SKILLS_DIR"; do
        [ -d "$skills_dir" ] || continue

        for skill in "$skills_dir"/*; do
            [ -d "$skill" ] || continue
            skill_name="$(basename "$skill")"
            rm -rf "$target/$skill_name"
            cp -R "$skill" "$target/$skill_name"
            printf '%s\n' "$skill_name" >> "$tmp_marker"
        done
    done

    mv "$tmp_marker" "$marker"
}

merge_json_object() {
    local target="$1"
    local overlay="$2"
    local current
    local merged

    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install AI settings." >&2
        exit 1
    }

    mkdir -p "$(dirname "$target")"
    current="$(mktemp "${target}.current.XXXXXX")"
    merged="$(mktemp "${target}.merged.XXXXXX")"

    if [ -f "$target" ]; then
        cp "$target" "$current"
    else
        printf '{}\n' > "$current"
    fi

    jq -s '.[0] * .[1]' "$current" "$overlay" > "$merged"

    mv "$merged" "$target"
    rm -f "$current"
}

clear_ai_skills() {
    local target="$1"
    local marker
    local skill_name

    marker="$target/.dotfiles-managed"

    [ -f "$marker" ] || return 0

    while IFS= read -r skill_name; do
        [ -n "$skill_name" ] || continue
        rm -rf "$target/$skill_name"
    done < "$marker"

    rm -f "$marker"
}

install_managed_directories() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -rf "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -d "$item" ] || continue
            item_name="$(basename "$item")"
            rm -rf "$target/$item_name"
            cp -R "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

install_managed_files() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -f "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -f "$item" ] || continue
            item_name="$(basename "$item")"
            rm -f "$target/$item_name"
            cp "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

should_install() {
    local base_dir="$1"

    [ -d "$base_dir" ] || [ "$FORCE" -eq 1 ]
}

install_pi_agents() (
    local target="$1"
    local prepared
    local agent
    local item

    if [ ! -f "$PI_AGENTS_LOCAL" ]; then
        install_managed_files "$PI_AGENTS_DIR" "$target"
        return
    fi

    jq -e '
        def thinking_levels: ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
        type == "object" and all(to_entries[];
            (.key | test("^[a-zA-Z0-9_-]+$")) and
            (.value | type == "object" and
                all(to_entries[];
                    if .key == "model" then
                        (.value | type == "string" and test("^[^/[:space:]]+/[^[:space:]]+$"))
                    elif .key == "thinking" then
                        (.value as $level | thinking_levels | index($level) != null)
                    else false end
                )
            )
        )
    ' "$PI_AGENTS_LOCAL" >/dev/null || {
        echo "Invalid Pi agent overrides: $PI_AGENTS_LOCAL. Expected agent objects with model (provider/model-id) and/or thinking." >&2
        exit 1
    }

    while IFS= read -r agent; do
        if [ ! -f "$PI_AGENTS_DIR/$agent.md" ]; then
            echo "Unknown Pi agent in $PI_AGENTS_LOCAL: $agent" >&2
            exit 1
        fi
    done < <(jq -r 'keys[]' "$PI_AGENTS_LOCAL")

    prepared="$(mktemp -d)"
    trap 'rm -rf "$prepared"' EXIT
    for item in "$PI_AGENTS_DIR"/*.md; do
        agent="$(basename "$item" .md)"
        jq -Rrsj --slurpfile overrides "$PI_AGENTS_LOCAL" --arg agent "$agent" '
            ($overrides[0][$agent] // {}) as $fields |
            if $fields == {} then . else
                capture("\\A(?<start>---\\n)(?<header>[\\s\\S]*?)(?<end>\\n---(?:\\n|$))(?<body>[\\s\\S]*)\\z") as $doc |
                (reduce ($fields | to_entries[]) as $field ($doc.header;
                    ($field.key + ": " + ($field.value | tojson)) as $line |
                    if test("(?m)^" + $field.key + ":[^\\n]*$") then
                        sub("(?m)^" + $field.key + ":[^\\n]*$"; $line)
                    else . + "\n" + $line end
                )) as $header |
                $doc.start + $header + $doc.end + $doc.body
            end
        ' "$item" > "$prepared/$agent.md"
        if [ ! -s "$prepared/$agent.md" ]; then
            echo "Cannot apply Pi agent overrides: invalid frontmatter in $item" >&2
            exit 1
        fi
    done
    install_managed_files "$prepared" "$target"
)

install_agent() {
    local name="$1"
    local base_dir="$2"
    local tool_file="$3"
    local instructions_target="$4"
    local skills_target="$5"

    if ! should_install "$base_dir"; then
        echo "Skipped $name because $base_dir does not exist. Use --force to create it."
        return
    fi

    install_ai_instructions "$tool_file" "$instructions_target"
    install_ai_skills "$skills_target"

    echo "Installed $name instructions to $instructions_target"
    echo "Installed $name skills to $skills_target"
}

install_instructions_target() {
    local name="$1"
    local base_dir="$2"
    local tool_file="$3"
    local instructions_target="$4"

    if ! should_install "$base_dir"; then
        echo "Skipped $name because $base_dir does not exist. Use --force to create it."
        return 1
    fi

    install_ai_instructions "$tool_file" "$instructions_target"
    echo "Installed $name instructions to $instructions_target"
}

install_pi() {
    local pi_base="$HOME/.pi/agent"
    local agents_base="$HOME/.agents"

    if ! install_instructions_target "Pi" "$pi_base" pi.md "$pi_base/AGENTS.md"; then
        return
    fi

    install_managed_directories "$PI_EXTENSIONS_DIR" "$pi_base/extensions"
    install_pi_agents "$pi_base/agents"
    merge_json_object "$pi_base/settings.json" "$PI_SETTINGS"
    merge_json_object "$pi_base/i-have-adhd.json" "$PI_ADHD_CONFIG"
    echo "Installed Pi extensions to $pi_base/extensions"
    echo "Installed Pi agents to $pi_base/agents"
    echo "Merged Pi settings into $pi_base/settings.json"
    echo "Merged i-have-adhd config into $pi_base/i-have-adhd.json"

    if should_install "$agents_base"; then
        install_ai_skills "$agents_base/skills"
        clear_ai_skills "$pi_base/skills"
        mkdir -p "$pi_base/skills"
        echo "Installed Pi skills to $agents_base/skills"
        echo "Created Pi-specific skills directory at $pi_base/skills"
        return
    fi

    install_ai_skills "$pi_base/skills"
    echo "Installed Pi skills to $pi_base/skills"
}

validate_only_list

if is_selected pi; then
    install_pi
fi

if is_selected codex; then
    install_agent "Codex" "$HOME/.codex" codex.md "$HOME/.codex/AGENTS.md" "$HOME/.codex/skills"
fi

if is_selected claude; then
    install_agent "Claude" "$HOME/.claude" claude.md "$HOME/.claude/CLAUDE.md" "$HOME/.claude/skills"
fi
