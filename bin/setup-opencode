#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OPENCODE_DIR="$ROOT_DIR/opencode"
SKILLS_DIR="$ROOT_DIR/pi/skills"
LOCAL_SKILLS_DIR="$ROOT_DIR/pi/skills-local"
OPENCODE_AGENTS_DIR="$OPENCODE_DIR/agents"
OPENCODE_COMMANDS_DIR="$OPENCODE_DIR/commands"
OPENCODE_INSTRUCTIONS_DIR="$OPENCODE_DIR/instructions"
OPENCODE_PROFILES_DIR="$OPENCODE_DIR/profiles"
ACTIVE_PROFILE_NAME="active"
OPENCODE_ACTIVE_PROFILE="$OPENCODE_PROFILES_DIR/$ACTIVE_PROFILE_NAME.json"
OPENCODE_CONFIG="$OPENCODE_DIR/opencode.json"
OPENCODE_CONFIG_LOCAL="$OPENCODE_DIR/opencode.local.json"
OPENCODE_INSTRUCTIONS="$OPENCODE_DIR/AGENTS.md"
PROFILE=""
NINE_ROUTER_PROVIDER_ID="9router"
NINE_ROUTER_PROVIDER_FILE="$OPENCODE_DIR/providers/9router.json"
NINE_ROUTER_MODELS_FILTER="$OPENCODE_DIR/9router-models.jq"
NINE_ROUTER_FETCH_TIMEOUT_SECONDS=10
NINE_ROUTER_REQUIRED_ENV=(NINE_ROUTER_BASE_URL NINE_ROUTER_API_KEY CF_ACCESS_CLIENT_ID CF_ACCESS_CLIENT_SECRET)

usage() {
    cat <<EOF
Usage: setup-opencode [--profile NAME]

Installs OpenCode instructions, agents, commands, skills, and config into ~/.config/opencode.

Options:
  --profile NAME  Select the OpenCode profile from opencode/profiles/ before installing.
  --help, -h   Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --profile)
            if [ "$#" -lt 2 ]; then
                echo "--profile requires a profile name." >&2
                usage >&2
                exit 1
            fi
            PROFILE="$2"
            shift
            ;;
        --profile=*)
            PROFILE="${1#--profile=}"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

install_skills() {
    local target="$1"
    local marker
    local skill
    local skill_name
    local skills_dir
    local tmp_marker

    marker="$target/.dotfiles-managed"

    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r skill_name; do
            [ -n "$skill_name" ] || continue
            rm -rf "$target/$skill_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    for skills_dir in "$SKILLS_DIR" "$LOCAL_SKILLS_DIR"; do
        [ -d "$skills_dir" ] || continue

        for skill in "$skills_dir"/*; do
            [ -d "$skill" ] || continue
            skill_name="$(basename "$skill")"
            rm -rf "$target/$skill_name"
            cp -R "$skill" "$target/$skill_name"
            printf '%s\n' "$skill_name" >> "$tmp_marker"
        done
    done

    mv "$tmp_marker" "$marker"
}

merge_json_object() {
    local target="$1"
    local overlay="$2"
    local current
    local merged

    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install OpenCode config." >&2
        exit 1
    }

    mkdir -p "$(dirname "$target")"
    current="$(mktemp "${target}.current.XXXXXX")"
    merged="$(mktemp "${target}.merged.XXXXXX")"

    if [ -f "$target" ]; then
        cp "$target" "$current"
    else
        printf '{}\n' > "$current"
    fi

    jq -s '.[0] * .[1]' "$current" "$overlay" > "$merged"

    mv "$merged" "$target"
    rm -f "$current"
}

install_managed_files() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -f "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -f "$item" ] || continue
            item_name="$(basename "$item")"
            rm -f "$target/$item_name"
            cp "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

require_json_object() {
    local file="$1"

    jq -e 'type == "object"' "$file" >/dev/null 2>&1 || {
        echo "Invalid OpenCode config, expected a JSON object: $file" >&2
        exit 1
    }
}

opencode_overlay() {
    local files=("$OPENCODE_CONFIG" "$OPENCODE_ACTIVE_PROFILE")

    if [ -f "$OPENCODE_CONFIG_LOCAL" ]; then
        files+=("$OPENCODE_CONFIG_LOCAL")
    fi

    jq -s 'reduce .[] as $file ({}; . * $file)' "${files[@]}"
}

nine_router_warn() {
    echo "Skipping 9router provider: $1" >&2
}

# Writes the providers["9router"] overlay to $1. Returns non-zero (after one
# warning) on any failure, so callers under set -e must test the result.
# Never prints credentials or response bodies.
build_nine_router_overlay() {
    local out="$1"
    local name
    local response
    local models

    for name in "${NINE_ROUTER_REQUIRED_ENV[@]}"; do
        if [ -z "${!name:-}" ]; then
            nine_router_warn "$name is not set."
            return 1
        fi
    done

    command -v curl >/dev/null 2>&1 || {
        nine_router_warn "curl is not installed."
        return 1
    }

    # Headers go through stdin (-H @-) so the secrets never appear in argv.
    # No -L: a redirect must not forward the credentials to another host.
    if ! response="$(
        printf 'Authorization: Bearer %s\nCF-Access-Client-Id: %s\nCF-Access-Client-Secret: %s\n' \
            "$NINE_ROUTER_API_KEY" "$CF_ACCESS_CLIENT_ID" "$CF_ACCESS_CLIENT_SECRET" |
            curl -fsS --max-time "$NINE_ROUTER_FETCH_TIMEOUT_SECONDS" --proto =https \
                -H @- "$NINE_ROUTER_BASE_URL/models" 2>/dev/null
    )"; then
        nine_router_warn "could not fetch the model list."
        return 1
    fi

    # -e makes an empty or null filter result a failure.
    if ! models="$(printf '%s' "$response" | jq -ce -f "$NINE_ROUTER_MODELS_FILTER" 2>/dev/null)"; then
        nine_router_warn "the model list response is invalid."
        return 1
    fi

    if ! printf '%s' "$models" | jq -e 'length > 0' >/dev/null 2>&1; then
        nine_router_warn "no usable models in the response."
        return 1
    fi

    # Models go through stdin: a single argv entry is capped at 128 KB on Linux.
    if ! printf '%s' "$models" | jq --arg id "$NINE_ROUTER_PROVIDER_ID" --slurpfile m /dev/stdin \
        '{providers: {($id): (. + {models: $m[0]})}}' \
        "$NINE_ROUTER_PROVIDER_FILE" > "$out" 2>/dev/null; then
        nine_router_warn "could not build the provider config."
        return 1
    fi
}

# Writes the installed config $1 to the temp file $3 with provider $2 removed,
# so a fresh one replaces it completely instead of deep-merging into stale
# models. Only deletes when .providers is an object; otherwise copies as is.
# Does not touch $1. Prints no warning; the caller does.
prepare_installed_trim() {
    local target="$1"
    local provider_id="$2"
    local trimmed="$3"

    jq --arg id "$provider_id" \
        'if (.providers | type) == "object" then del(.providers[$id]) else . end' \
        "$target" > "$trimmed" 2>/dev/null
}

# Builds the 9router overlay, combines it into a temp file, and prepares the
# trimmed installed config in another temp file. Nothing is committed until all
# of that succeeded. Then commits the trim ($2) first and the overlay ($1)
# second. If the overlay commit fails, the installed config is restored from a
# backup. Any failure leaves $1 and $2 unchanged, removes all temp files, and
# returns non-zero after exactly one warning.
# Call from an `if`: set -e is inactive inside, so every step is guarded.
apply_nine_router() {
    local overlay="$1"
    local installed="$2"
    local nine_overlay=""
    local combined=""
    local trimmed=""
    local backup=""
    local rc=0

    nine_overlay="$(mktemp 2>/dev/null)" &&
        combined="$(mktemp 2>/dev/null)" || {
        nine_router_warn "could not create a temp file."
        rm -f "$nine_overlay" "$combined"
        return 1
    }

    # build_nine_router_overlay prints its own warning.
    if ! build_nine_router_overlay "$nine_overlay"; then
        rc=1
    elif ! jq -s '.[0] * .[1]' "$overlay" "$nine_overlay" > "$combined" 2>/dev/null; then
        nine_router_warn "could not combine the provider config."
        rc=1
    elif [ -f "$installed" ]; then
        if ! trimmed="$(mktemp "${installed}.trimmed.XXXXXX" 2>/dev/null)" ||
            ! backup="$(mktemp "${installed}.backup.XXXXXX" 2>/dev/null)"; then
            nine_router_warn "could not create a temp file for the installed config."
            rc=1
        elif ! prepare_installed_trim "$installed" "$NINE_ROUTER_PROVIDER_ID" "$trimmed"; then
            nine_router_warn "could not trim the installed config."
            rc=1
        elif ! cp "$installed" "$backup" 2>/dev/null; then
            nine_router_warn "could not back up the installed config."
            rc=1
        elif ! mv "$trimmed" "$installed" 2>/dev/null; then
            nine_router_warn "could not update the installed config."
            rc=1
        elif ! mv "$combined" "$overlay" 2>/dev/null; then
            # Trim was committed: put the original installed config back.
            if mv "$backup" "$installed" 2>/dev/null; then
                nine_router_warn "could not update the config overlay."
            else
                nine_router_warn "could not update the config overlay and could not restore the installed config."
            fi
            rc=1
        fi
    elif ! mv "$combined" "$overlay" 2>/dev/null; then
        nine_router_warn "could not update the config overlay."
        rc=1
    fi

    rm -f "$nine_overlay" "$combined" "$trimmed" "$backup"
    return "$rc"
}

install_opencode() {
    local opencode_base="$HOME/.config/opencode"
    local overlay

    if [ ! -f "$OPENCODE_ACTIVE_PROFILE" ]; then
        echo "No OpenCode profile selected. Run setup-opencode --profile <name>. Available: $(list_opencode_profiles)" >&2
        exit 1
    fi

    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install OpenCode config." >&2
        exit 1
    }

    require_json_object "$OPENCODE_CONFIG"
    require_json_object "$OPENCODE_ACTIVE_PROFILE"
    if [ -f "$OPENCODE_CONFIG_LOCAL" ]; then
        require_json_object "$OPENCODE_CONFIG_LOCAL"
    fi

    mkdir -p "$opencode_base"
    cp "$OPENCODE_INSTRUCTIONS" "$opencode_base/AGENTS.md"
    echo "Installed OpenCode instructions to $opencode_base/AGENTS.md"

    overlay="$(mktemp)"
    opencode_overlay > "$overlay"

    if apply_nine_router "$overlay" "$opencode_base/opencode.json"; then
        echo "Installed 9router provider with fresh model list (merged below)"
    fi

    merge_json_object "$opencode_base/opencode.json" "$overlay"
    rm -f "$overlay"
    echo "Merged OpenCode config into $opencode_base/opencode.json"
    if [ -L "$OPENCODE_ACTIVE_PROFILE" ]; then
        local active_profile
        active_profile="$(basename "$(readlink "$OPENCODE_ACTIVE_PROFILE")" .json)"
        echo "Active OpenCode profile: $active_profile"
    fi
    if [ -f "$OPENCODE_CONFIG_LOCAL" ]; then
        echo "Merged OpenCode local config from $OPENCODE_CONFIG_LOCAL"
    fi

    install_managed_files "$OPENCODE_AGENTS_DIR" "$opencode_base/agents"
    echo "Installed OpenCode agents to $opencode_base/agents"
    install_managed_files "$OPENCODE_COMMANDS_DIR" "$opencode_base/commands"
    echo "Installed OpenCode commands to $opencode_base/commands"
    install_managed_files "$OPENCODE_INSTRUCTIONS_DIR" "$opencode_base/instructions"
    echo "Installed OpenCode instruction files to $opencode_base/instructions"

    install_skills "$opencode_base/skills"
    echo "Installed OpenCode skills to $opencode_base/skills"
}

list_opencode_profiles() {
    local available=()
    local item

    for item in "$OPENCODE_PROFILES_DIR"/*.json; do
        [ -e "$item" ] || continue
        # active.json is the selection symlink, not a profile
        [ "$(basename "$item" .json)" = "$ACTIVE_PROFILE_NAME" ] && continue
        available+=("$(basename "$item" .json)")
    done
    echo "${available[*]:-}"
}

select_opencode_profile() {
    if [[ ! "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "Invalid OpenCode profile name: $PROFILE" >&2
        exit 1
    fi

    if [ "$PROFILE" = "$ACTIVE_PROFILE_NAME" ]; then
        echo "$ACTIVE_PROFILE_NAME is reserved for the selection symlink. Available: $(list_opencode_profiles)" >&2
        exit 1
    fi

    if [ ! -f "$OPENCODE_PROFILES_DIR/$PROFILE.json" ]; then
        echo "Unknown OpenCode profile: $PROFILE. Available: $(list_opencode_profiles)" >&2
        exit 1
    fi

    # Never overwrite a hand-written override file.
    if [ -e "$OPENCODE_ACTIVE_PROFILE" ] && [ ! -L "$OPENCODE_ACTIVE_PROFILE" ]; then
        echo "$OPENCODE_ACTIVE_PROFILE is a regular file. Move it to another name in $OPENCODE_PROFILES_DIR before using --profile." >&2
        exit 1
    fi

    ln -sfn "$PROFILE.json" "$OPENCODE_ACTIVE_PROFILE"
}

if [ -n "$PROFILE" ]; then
    select_opencode_profile
fi

install_opencode
