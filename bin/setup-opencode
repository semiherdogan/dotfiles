#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OPENCODE_DIR="$ROOT_DIR/opencode"
SKILLS_DIR="$ROOT_DIR/pi/skills"
LOCAL_SKILLS_DIR="$ROOT_DIR/pi/skills-local"
OPENCODE_AGENTS_DIR="$OPENCODE_DIR/agents"
OPENCODE_COMMANDS_DIR="$OPENCODE_DIR/commands"
OPENCODE_INSTRUCTIONS_DIR="$OPENCODE_DIR/instructions"
OPENCODE_PROFILES_DIR="$OPENCODE_DIR/profiles"
ACTIVE_PROFILE_NAME="active"
OPENCODE_ACTIVE_PROFILE="$OPENCODE_PROFILES_DIR/$ACTIVE_PROFILE_NAME.json"
OPENCODE_CONFIG="$OPENCODE_DIR/opencode.json"
OPENCODE_CONFIG_LOCAL="$OPENCODE_DIR/opencode.local.json"
OPENCODE_INSTRUCTIONS="$OPENCODE_DIR/AGENTS.md"
PROFILE=""

usage() {
    cat <<EOF
Usage: setup-opencode [--profile NAME]

Installs OpenCode instructions, agents, commands, skills, and config into ~/.config/opencode.

Options:
  --profile NAME  Select the OpenCode profile from opencode/profiles/ before installing.
  --help, -h   Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --profile)
            if [ "$#" -lt 2 ]; then
                echo "--profile requires a profile name." >&2
                usage >&2
                exit 1
            fi
            PROFILE="$2"
            shift
            ;;
        --profile=*)
            PROFILE="${1#--profile=}"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

install_skills() {
    local target="$1"
    local marker
    local skill
    local skill_name
    local skills_dir
    local tmp_marker

    marker="$target/.dotfiles-managed"

    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r skill_name; do
            [ -n "$skill_name" ] || continue
            rm -rf "$target/$skill_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    for skills_dir in "$SKILLS_DIR" "$LOCAL_SKILLS_DIR"; do
        [ -d "$skills_dir" ] || continue

        for skill in "$skills_dir"/*; do
            [ -d "$skill" ] || continue
            skill_name="$(basename "$skill")"
            rm -rf "$target/$skill_name"
            cp -R "$skill" "$target/$skill_name"
            printf '%s\n' "$skill_name" >> "$tmp_marker"
        done
    done

    mv "$tmp_marker" "$marker"
}

merge_json_object() {
    local target="$1"
    local overlay="$2"
    local current
    local merged

    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install OpenCode config." >&2
        exit 1
    }

    mkdir -p "$(dirname "$target")"
    current="$(mktemp "${target}.current.XXXXXX")"
    merged="$(mktemp "${target}.merged.XXXXXX")"

    if [ -f "$target" ]; then
        cp "$target" "$current"
    else
        printf '{}\n' > "$current"
    fi

    jq -s '.[0] * .[1]' "$current" "$overlay" > "$merged"

    mv "$merged" "$target"
    rm -f "$current"
}

install_managed_files() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -f "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -f "$item" ] || continue
            item_name="$(basename "$item")"
            rm -f "$target/$item_name"
            cp "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

require_json_object() {
    local file="$1"

    jq -e 'type == "object"' "$file" >/dev/null 2>&1 || {
        echo "Invalid OpenCode config, expected a JSON object: $file" >&2
        exit 1
    }
}

opencode_overlay() {
    local files=("$OPENCODE_CONFIG" "$OPENCODE_ACTIVE_PROFILE")

    if [ -f "$OPENCODE_CONFIG_LOCAL" ]; then
        files+=("$OPENCODE_CONFIG_LOCAL")
    fi

    jq -s 'reduce .[] as $file ({}; . * $file)' "${files[@]}"
}

install_opencode() {
    local opencode_base="$HOME/.config/opencode"
    local overlay

    if [ ! -f "$OPENCODE_ACTIVE_PROFILE" ]; then
        echo "No OpenCode profile selected. Run setup-opencode --profile <name>. Available: $(list_opencode_profiles)" >&2
        exit 1
    fi

    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install OpenCode config." >&2
        exit 1
    }

    require_json_object "$OPENCODE_CONFIG"
    require_json_object "$OPENCODE_ACTIVE_PROFILE"
    if [ -f "$OPENCODE_CONFIG_LOCAL" ]; then
        require_json_object "$OPENCODE_CONFIG_LOCAL"
    fi

    mkdir -p "$opencode_base"
    cp "$OPENCODE_INSTRUCTIONS" "$opencode_base/AGENTS.md"
    echo "Installed OpenCode instructions to $opencode_base/AGENTS.md"

    overlay="$(mktemp)"
    opencode_overlay > "$overlay"
    merge_json_object "$opencode_base/opencode.json" "$overlay"
    rm -f "$overlay"
    echo "Merged OpenCode config into $opencode_base/opencode.json"
    if [ -L "$OPENCODE_ACTIVE_PROFILE" ]; then
        local active_profile
        active_profile="$(basename "$(readlink "$OPENCODE_ACTIVE_PROFILE")" .json)"
        echo "Active OpenCode profile: $active_profile"
    fi
    if [ -f "$OPENCODE_CONFIG_LOCAL" ]; then
        echo "Merged OpenCode local config from $OPENCODE_CONFIG_LOCAL"
    fi

    install_managed_files "$OPENCODE_AGENTS_DIR" "$opencode_base/agents"
    echo "Installed OpenCode agents to $opencode_base/agents"
    install_managed_files "$OPENCODE_COMMANDS_DIR" "$opencode_base/commands"
    echo "Installed OpenCode commands to $opencode_base/commands"
    install_managed_files "$OPENCODE_INSTRUCTIONS_DIR" "$opencode_base/instructions"
    echo "Installed OpenCode instruction files to $opencode_base/instructions"

    install_skills "$opencode_base/skills"
    echo "Installed OpenCode skills to $opencode_base/skills"
}

list_opencode_profiles() {
    local available=()
    local item

    for item in "$OPENCODE_PROFILES_DIR"/*.json; do
        [ -e "$item" ] || continue
        # active.json is the selection symlink, not a profile
        [ "$(basename "$item" .json)" = "$ACTIVE_PROFILE_NAME" ] && continue
        available+=("$(basename "$item" .json)")
    done
    echo "${available[*]:-}"
}

select_opencode_profile() {
    if [[ ! "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "Invalid OpenCode profile name: $PROFILE" >&2
        exit 1
    fi

    if [ "$PROFILE" = "$ACTIVE_PROFILE_NAME" ]; then
        echo "$ACTIVE_PROFILE_NAME is reserved for the selection symlink. Available: $(list_opencode_profiles)" >&2
        exit 1
    fi

    if [ ! -f "$OPENCODE_PROFILES_DIR/$PROFILE.json" ]; then
        echo "Unknown OpenCode profile: $PROFILE. Available: $(list_opencode_profiles)" >&2
        exit 1
    fi

    # Never overwrite a hand-written override file.
    if [ -e "$OPENCODE_ACTIVE_PROFILE" ] && [ ! -L "$OPENCODE_ACTIVE_PROFILE" ]; then
        echo "$OPENCODE_ACTIVE_PROFILE is a regular file. Move it to another name in $OPENCODE_PROFILES_DIR before using --profile." >&2
        exit 1
    fi

    ln -sfn "$PROFILE.json" "$OPENCODE_ACTIVE_PROFILE"
}

if [ -n "$PROFILE" ]; then
    select_opencode_profile
fi

install_opencode
