#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PI_DIR="$ROOT_DIR/pi"
SKILLS_DIR="$PI_DIR/skills"
LOCAL_SKILLS_DIR="$PI_DIR/skills-local"
PI_EXTENSIONS_DIR="$PI_DIR/extensions"
PI_AGENTS_DIR="$PI_DIR/agents"
PI_PROFILES_DIR="$PI_DIR/profiles"
ACTIVE_PROFILE_NAME="active"
PI_ACTIVE_PROFILE="$PI_DIR/profiles/$ACTIVE_PROFILE_NAME.json"
PI_MODELS_LOCAL="$PI_DIR/models.local.json"
PI_SETTINGS="$PI_DIR/settings.json"
PI_SETTINGS_LOCAL="$PI_DIR/settings.local.json"
PI_ADHD_CONFIG="$PI_DIR/i-have-adhd.json"
PI_KEYBINDINGS="$PI_DIR/keybindings.json"
PI_INSTRUCTIONS="$PI_DIR/AGENTS.md"
PROFILE=""

usage() {
    cat <<EOF
Usage: setup-pi [--profile NAME]

Installs Pi instructions, agents, extensions, skills, and settings into ~/.pi/agent.

Options:
  --profile NAME  Select the Pi agent profile from pi/profiles/ before installing.
  --help, -h   Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --profile)
            if [ "$#" -lt 2 ]; then
                echo "--profile requires a profile name." >&2
                usage >&2
                exit 1
            fi
            PROFILE="$2"
            shift
            ;;
        --profile=*)
            PROFILE="${1#--profile=}"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

install_skills() {
    local target="$1"
    local marker
    local skill
    local skill_name
    local skills_dir
    local tmp_marker

    marker="$target/.dotfiles-managed"

    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r skill_name; do
            [ -n "$skill_name" ] || continue
            rm -rf "$target/$skill_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    for skills_dir in "$SKILLS_DIR" "$LOCAL_SKILLS_DIR"; do
        [ -d "$skills_dir" ] || continue

        for skill in "$skills_dir"/*; do
            [ -d "$skill" ] || continue
            skill_name="$(basename "$skill")"
            rm -rf "$target/$skill_name"
            cp -R "$skill" "$target/$skill_name"
            printf '%s\n' "$skill_name" >> "$tmp_marker"
        done
    done

    mv "$tmp_marker" "$marker"
}

merge_json_object() {
    local target="$1"
    local overlay="$2"
    local current
    local merged

    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install Pi settings." >&2
        exit 1
    }

    mkdir -p "$(dirname "$target")"
    current="$(mktemp "${target}.current.XXXXXX")"
    merged="$(mktemp "${target}.merged.XXXXXX")"

    if [ -f "$target" ]; then
        cp "$target" "$current"
    else
        printf '{}\n' > "$current"
    fi

    jq -s '.[0] * .[1]' "$current" "$overlay" > "$merged"

    mv "$merged" "$target"
    rm -f "$current"
}

install_managed_directories() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -rf "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -d "$item" ] || continue
            item_name="$(basename "$item")"
            rm -rf "$target/$item_name"
            cp -R "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

install_managed_files() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -f "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -f "$item" ] || continue
            item_name="$(basename "$item")"
            rm -f "$target/$item_name"
            cp "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

validate_pi_agent_overrides() {
    local agent

    jq -e '
        def thinking_levels: ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
        def model_ref: type == "string" and test("^[^/[:space:]]+/[^[:space:]]+$");
        type == "object" and all(to_entries[];
            (.key | test("^[a-zA-Z0-9_-]+$")) and
            (.value | type == "object" and
                all(to_entries[];
                    if .key == "model" or .key == "escalationModel" then
                        (.value | model_ref)
                    elif .key == "thinking" then
                        (.value as $level | thinking_levels | index($level) != null)
                    else false end
                )
            )
        )
    ' "$PI_ACTIVE_PROFILE" >/dev/null || {
        echo "Invalid Pi agent overrides: $PI_ACTIVE_PROFILE. Expected agent objects with model and/or escalationModel (provider/model-id) and/or thinking." >&2
        exit 1
    }

    while IFS= read -r agent; do
        if [ ! -f "$PI_AGENTS_DIR/$agent.md" ]; then
            echo "Unknown Pi agent in $PI_ACTIVE_PROFILE: $agent" >&2
            exit 1
        fi
    done < <(jq -r 'keys[]' "$PI_ACTIVE_PROFILE")
}

# Effective per-agent fields: frontmatter values with the local overrides applied on top.
# Agent bodies reference them as {{agent.field}} so no prompt carries a provider-specific
# model id that only holds on one machine.
pi_agent_vars() {
    local overrides="$1"
    local vars='{}'
    local item
    local agent

    for item in "$PI_AGENTS_DIR"/*.md; do
        agent="$(basename "$item" .md)"
        vars="$(jq -Rrs --argjson acc "$vars" --arg agent "$agent" '
            (capture("\\A---\\n(?<header>[\\s\\S]*?)\\n---(?:\\n|$)").header) as $header |
            ($header
                | [scan("(?m)^([A-Za-z][A-Za-z0-9_-]*):[ \\t]*(.*)$")]
                | map({key: .[0], value: (.[1] | gsub("^[\"\u0027] *| *[\"\u0027]$"; ""))})
                | from_entries
                | {model, thinking}
                | with_entries(select(.value != null and .value != ""))) as $fields |
            $acc + {($agent): $fields}
        ' "$item")"
    done

    # escalationModel has no frontmatter counterpart: without a local override it falls back to
    # the primary agent's model, which is the strongest one configured on this machine.
    jq -n --argjson vars "$vars" --slurpfile overrides "$overrides" '
        ($vars * $overrides[0]) as $merged |
        $merged.architect.model as $strongest |
        $merged | with_entries(.value |= ({escalationModel: $strongest} + .))
    '
}

install_pi_agents() (
    local target="$1"
    local prepared
    local overrides
    local vars
    local missing
    local agent
    local item

    prepared="$(mktemp -d)"
    overrides="$(mktemp)"
    trap 'rm -rf "$prepared" "$overrides"' EXIT

    if [ ! -f "$PI_ACTIVE_PROFILE" ]; then
        echo "No Pi agent profile selected. Run setup-pi --profile <name>. Available: $(list_pi_profiles)" >&2
        exit 1
    fi

    validate_pi_agent_overrides
    cp "$PI_ACTIVE_PROFILE" "$overrides"

    vars="$(pi_agent_vars "$overrides")"

    missing="$(jq -r 'to_entries[] | select(.value.model == null or .value.model == "") | .key' <<< "$vars" | tr '\n' ' ')"
    missing="${missing% }"
    if [ -n "$missing" ]; then
        echo "Pi agent profile does not set a model for: $missing ($PI_ACTIVE_PROFILE)" >&2
        exit 1
    fi

    for item in "$PI_AGENTS_DIR"/*.md; do
        agent="$(basename "$item" .md)"
        jq -Rrsj --slurpfile overrides "$overrides" --argjson vars "$vars" --arg agent "$agent" '
            ($overrides[0][$agent] // {} | del(.escalationModel)) as $fields |
            (if $fields == {} then . else
                capture("\\A(?<start>---\\n)(?<header>[\\s\\S]*?)(?<end>\\n---(?:\\n|$))(?<body>[\\s\\S]*)\\z") as $doc |
                (reduce ($fields | to_entries[]) as $field ($doc.header;
                    ($field.key + ": " + ($field.value | tojson)) as $line |
                    if test("(?m)^" + $field.key + ":[^\\n]*$") then
                        sub("(?m)^" + $field.key + ":[^\\n]*$"; $line)
                    else . + "\n" + $line end
                )) as $header |
                $doc.start + $header + $doc.end + $doc.body
            end)
            | gsub("\\{\\{(?<a>[A-Za-z0-9_-]+)\\.(?<f>[A-Za-z0-9_]+)(:(?<d>[^}]*))?\\}\\}";
                . as $ref |
                ($vars[$ref.a][$ref.f] // $ref.d //
                    error("unresolved placeholder {{" + $ref.a + "." + $ref.f + "}} in " + $agent + ".md")))
        ' "$item" > "$prepared/$agent.md"
        if [ ! -s "$prepared/$agent.md" ]; then
            echo "Cannot prepare Pi agent: invalid frontmatter in $item" >&2
            exit 1
        fi
    done
    install_managed_files "$prepared" "$target"
)

pi_settings_overlay() {
    if [ ! -f "$PI_SETTINGS_LOCAL" ]; then
        cat "$PI_SETTINGS"
        return
    fi

    # The deep merge replaces arrays wholesale, so the shared package list is re-added to keep it alongside a local one.
    jq -s '
        . as [$base, $local]
        | ($base * $local)
        | .packages = (
            reduce (($base.packages // []) + ($local.packages // []))[] as $p ([]; if index([$p]) then . else . + [$p] end)
        )
    ' "$PI_SETTINGS" "$PI_SETTINGS_LOCAL"
}

install_pi() {
    local pi_base="$HOME/.pi/agent"

    mkdir -p "$pi_base"
    cp "$PI_INSTRUCTIONS" "$pi_base/AGENTS.md"
    echo "Installed Pi instructions to $pi_base/AGENTS.md"

    install_managed_directories "$PI_EXTENSIONS_DIR" "$pi_base/extensions"
    install_pi_agents "$pi_base/agents"
    local settings_overlay
    settings_overlay="$(mktemp)"
    pi_settings_overlay > "$settings_overlay"
    merge_json_object "$pi_base/settings.json" "$settings_overlay"
    rm -f "$settings_overlay"
    merge_json_object "$pi_base/i-have-adhd.json" "$PI_ADHD_CONFIG"
    merge_json_object "$pi_base/keybindings.json" "$PI_KEYBINDINGS"
    if [ -f "$PI_MODELS_LOCAL" ]; then
        merge_json_object "$pi_base/models.json" "$PI_MODELS_LOCAL"
        echo "Merged Pi models into $pi_base/models.json"
    fi
    echo "Installed Pi extensions to $pi_base/extensions"
    echo "Installed Pi agents to $pi_base/agents"
    if [ -L "$PI_ACTIVE_PROFILE" ]; then
        local active_profile
        active_profile="$(basename "$(readlink "$PI_ACTIVE_PROFILE")" .json)"
        echo "Active Pi agent profile: $active_profile"
    fi
    echo "Merged Pi settings into $pi_base/settings.json"
    if [ -f "$PI_SETTINGS_LOCAL" ]; then
        echo "Merged Pi local settings from $PI_SETTINGS_LOCAL"
    fi
    echo "Merged i-have-adhd config into $pi_base/i-have-adhd.json"
    echo "Merged Pi keybindings into $pi_base/keybindings.json"

    install_skills "$pi_base/skills"
    echo "Installed Pi skills to $pi_base/skills"
}

list_pi_profiles() {
    local available=()
    local item

    for item in "$PI_PROFILES_DIR"/*.json; do
        [ -e "$item" ] || continue
        # active.json is the selection symlink, not a profile
        [ "$(basename "$item" .json)" = "$ACTIVE_PROFILE_NAME" ] && continue
        available+=("$(basename "$item" .json)")
    done
    echo "${available[*]:-}"
}

select_pi_profile() {
    if [[ ! "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "Invalid Pi profile name: $PROFILE" >&2
        exit 1
    fi

    if [ "$PROFILE" = "$ACTIVE_PROFILE_NAME" ]; then
        echo "$ACTIVE_PROFILE_NAME is reserved for the selection symlink. Available: $(list_pi_profiles)" >&2
        exit 1
    fi

    if [ ! -f "$PI_PROFILES_DIR/$PROFILE.json" ]; then
        echo "Unknown Pi profile: $PROFILE. Available: $(list_pi_profiles)" >&2
        exit 1
    fi

    # Never overwrite a hand-written override file.
    if [ -e "$PI_ACTIVE_PROFILE" ] && [ ! -L "$PI_ACTIVE_PROFILE" ]; then
        echo "$PI_ACTIVE_PROFILE is a regular file. Move it to another name in $PI_PROFILES_DIR before using --profile." >&2
        exit 1
    fi

    ln -sfn "$PROFILE.json" "$PI_ACTIVE_PROFILE"
}

if [ -n "$PROFILE" ]; then
    select_pi_profile
fi

install_pi
