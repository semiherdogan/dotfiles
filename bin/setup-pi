#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PI_DIR="$ROOT_DIR/pi"
SKILLS_DIR="$PI_DIR/skills"
LOCAL_SKILLS_DIR="$PI_DIR/skills-local"
PI_EXTENSIONS_DIR="$PI_DIR/extensions"
PI_AGENTS_DIR="$PI_DIR/agents"
PI_PROFILES_DIR="$PI_DIR/profiles"
PI_PROFILE_STATE_FILE="profile-state.json"
PI_MODELS_LOCAL="$PI_DIR/models.local.json"
PI_SETTINGS="$PI_DIR/settings.json"
PI_SETTINGS_LOCAL="$PI_DIR/settings.local.json"
PI_PERMISSIONS="$PI_DIR/permissions.json"
PI_PERMISSIONS_LOCAL="$PI_DIR/permissions.local.json"
PI_ADHD_CONFIG="$PI_DIR/i-have-adhd.json"
PI_KEYBINDINGS="$PI_DIR/keybindings.json"
PI_INSTRUCTIONS="$PI_DIR/AGENTS.md"
PROFILE=""

usage() {
    cat <<EOF
Usage: setup-pi [--profile NAME]

Installs Pi instructions, agents, profiles, extensions, skills, and settings into ~/.pi/agent.

Options:
  --profile NAME  Install pi/profiles/ and select NAME in ~/.pi/agent/profile-state.json.
  --help, -h   Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --profile)
            if [ "$#" -lt 2 ]; then
                echo "--profile requires a profile name." >&2
                usage >&2
                exit 1
            fi
            PROFILE="$2"
            shift
            ;;
        --profile=*)
            PROFILE="${1#--profile=}"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

install_skills() {
    local target="$1"
    local marker
    local skill
    local skill_name
    local skills_dir
    local tmp_marker

    marker="$target/.dotfiles-managed"

    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r skill_name; do
            [ -n "$skill_name" ] || continue
            rm -rf "$target/$skill_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    for skills_dir in "$SKILLS_DIR" "$LOCAL_SKILLS_DIR"; do
        [ -d "$skills_dir" ] || continue

        for skill in "$skills_dir"/*; do
            [ -d "$skill" ] || continue
            skill_name="$(basename "$skill")"
            rm -rf "$target/$skill_name"
            cp -R "$skill" "$target/$skill_name"
            printf '%s\n' "$skill_name" >> "$tmp_marker"
        done
    done

    mv "$tmp_marker" "$marker"
}

require_jq() {
    command -v jq >/dev/null 2>&1 || {
        echo "jq is required to install Pi settings." >&2
        exit 1
    }
}

merge_json_object() {
    local target="$1"
    local overlay="$2"
    local current
    local merged

    require_jq

    mkdir -p "$(dirname "$target")"
    current="$(mktemp "${target}.current.XXXXXX")"
    merged="$(mktemp "${target}.merged.XXXXXX")"

    if [ -f "$target" ]; then
        cp "$target" "$current"
    else
        printf '{}\n' > "$current"
    fi

    jq -s '.[0] * .[1]' "$current" "$overlay" > "$merged"

    mv "$merged" "$target"
    rm -f "$current"
}

install_managed_directories() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -rf "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -d "$item" ] || continue
            item_name="$(basename "$item")"
            rm -rf "$target/$item_name"
            cp -R "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

install_managed_files() {
    local source="$1"
    local target="$2"
    local marker
    local item
    local item_name
    local tmp_marker

    marker="$target/.dotfiles-managed"
    mkdir -p "$target"

    if [ -f "$marker" ]; then
        while IFS= read -r item_name; do
            [ -n "$item_name" ] || continue
            rm -f "$target/$item_name"
        done < "$marker"
    fi

    tmp_marker="$(mktemp "${marker}.tmp.XXXXXX")"
    if [ -d "$source" ]; then
        for item in "$source"/*; do
            [ -f "$item" ] || continue
            item_name="$(basename "$item")"
            rm -f "$target/$item_name"
            cp "$item" "$target/$item_name"
            printf '%s\n' "$item_name" >> "$tmp_marker"
        done
    fi

    mv "$tmp_marker" "$marker"
}

# Detailed validation belongs to pi-open-agents; a non-object file cannot be installed as a profile.
validate_pi_profiles() {
    local profile

    for profile in "$PI_PROFILES_DIR"/*.json; do
        [ -e "$profile" ] || continue
        if ! jq -e 'type == "object"' "$profile" >/dev/null; then
            echo "Invalid Pi profile: $profile. Expected a JSON object." >&2
            return 1
        fi
    done
}

validate_pi_profile_selection() {
    if [[ ! "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]]; then
        echo "Invalid Pi profile name: $PROFILE" >&2
        exit 1
    fi

    if [ ! -f "$PI_PROFILES_DIR/$PROFILE.json" ]; then
        echo "Unknown Pi profile: $PROFILE. Available: $(list_pi_profiles)" >&2
        exit 1
    fi
}

write_pi_profile_state() {
    local state="$1/$PI_PROFILE_STATE_FILE"
    local tmp

    tmp="$(mktemp "${state}.tmp.XXXXXX")"
    jq -n --arg active "$PROFILE" '{active: $active}' > "$tmp"
    mv "$tmp" "$state"
}

pi_settings_overlay() {
    if [ ! -f "$PI_SETTINGS_LOCAL" ]; then
        cat "$PI_SETTINGS"
        return
    fi

    # The deep merge replaces arrays wholesale, so the shared package list is re-added to keep it alongside a local one.
    jq -s '
        . as [$base, $local]
        | ($base * $local)
        | .packages = (
            reduce (($base.packages // []) + ($local.packages // []))[] as $p ([]; if index([$p]) then . else . + [$p] end)
        )
    ' "$PI_SETTINGS" "$PI_SETTINGS_LOCAL"
}

pi_permissions_overlay() {
    local local_permissions="$PI_PERMISSIONS_LOCAL"

    [ -f "$local_permissions" ] || local_permissions="/dev/null"

    # The deep merge replaces arrays wholesale, so list entries from both files are concatenated and deduplicated.
    jq -s '
        def union($a; $b): reduce (($a // []) + ($b // []))[] as $x ([]; if index([$x]) then . else . + [$x] end);
        (.[0]) as $base | (.[1] // {}) as $local
        | reduce (["trustedProjects"], ["alwaysDeny", "paths"], ["alwaysDeny", "tools"], ["alwaysDeny", "bash"]) as $p
            ($base * $local;
                if ($base | getpath($p)) != null or ($local | getpath($p)) != null
                then setpath($p; union($base | getpath($p); $local | getpath($p)))
                else . end)
    ' "$PI_PERMISSIONS" "$local_permissions"
}

# Written whole, never merged into the installed file: the repo is the source of truth for the policy.
install_pi_permissions() {
    local target="$1"
    local tmp

    tmp="$(mktemp "${target}.tmp.XXXXXX")"
    if ! pi_permissions_overlay > "$tmp" || ! jq -e '.version == 1' "$tmp" >/dev/null; then
        rm -f "$tmp"
        echo "Invalid Pi permission policy: $PI_PERMISSIONS (+ $PI_PERMISSIONS_LOCAL). Expected version 1." >&2
        exit 1
    fi
    mv "$tmp" "$target"
}

install_pi() {
    local pi_base="$HOME/.pi/agent"

    mkdir -p "$pi_base"
    cp "$PI_INSTRUCTIONS" "$pi_base/AGENTS.md"
    echo "Installed Pi instructions to $pi_base/AGENTS.md"

    install_managed_directories "$PI_EXTENSIONS_DIR" "$pi_base/extensions"
    install_managed_files "$PI_AGENTS_DIR" "$pi_base/agents"
    echo "Installed Pi agents to $pi_base/agents"

    # The previous profile mechanism wrote these; stale routes would mislead debugging after the move.
    rm -f "$pi_base/agent-profile.json"
    rm -rf "$pi_base/agent-profiles"
    install_managed_files "$PI_PROFILES_DIR" "$pi_base/profiles"
    echo "Installed Pi profiles to $pi_base/profiles"

    if [ -n "$PROFILE" ]; then
        write_pi_profile_state "$pi_base"
    elif [ ! -f "$pi_base/$PI_PROFILE_STATE_FILE" ]; then
        echo "No active Pi agent profile yet. Select one with setup-pi --profile <name> or /profile <name> inside Pi. Available: $(list_pi_profiles)"
    fi

    local settings_overlay
    settings_overlay="$(mktemp)"
    pi_settings_overlay > "$settings_overlay"
    merge_json_object "$pi_base/settings.json" "$settings_overlay"
    rm -f "$settings_overlay"
    install_pi_permissions "$pi_base/permissions.json"
    merge_json_object "$pi_base/i-have-adhd.json" "$PI_ADHD_CONFIG"
    merge_json_object "$pi_base/keybindings.json" "$PI_KEYBINDINGS"
    if [ -f "$PI_MODELS_LOCAL" ]; then
        merge_json_object "$pi_base/models.json" "$PI_MODELS_LOCAL"
        echo "Merged Pi models into $pi_base/models.json"
    fi
    echo "Installed Pi extensions to $pi_base/extensions"
    if [ -f "$pi_base/$PI_PROFILE_STATE_FILE" ]; then
        echo "Active Pi agent profile: $(jq -r '.active // empty' "$pi_base/$PI_PROFILE_STATE_FILE")"
    fi
    echo "Merged Pi settings into $pi_base/settings.json"
    if [ -f "$PI_SETTINGS_LOCAL" ]; then
        echo "Merged Pi local settings from $PI_SETTINGS_LOCAL"
    fi
    echo "Installed Pi permission policy to $pi_base/permissions.json"
    if [ -f "$PI_PERMISSIONS_LOCAL" ]; then
        echo "Merged Pi local permissions from $PI_PERMISSIONS_LOCAL"
    fi
    echo "Merged i-have-adhd config into $pi_base/i-have-adhd.json"
    echo "Merged Pi keybindings into $pi_base/keybindings.json"

    install_skills "$pi_base/skills"
    echo "Installed Pi skills to $pi_base/skills"
}

list_pi_profiles() {
    local available=()
    local item

    for item in "$PI_PROFILES_DIR"/*.json; do
        [ -e "$item" ] || continue
        available+=("$(basename "$item" .json)")
    done
    echo "${available[*]:-}"
}

if [ -n "$PROFILE" ]; then
    validate_pi_profile_selection
fi

require_jq

validate_pi_profiles

install_pi
